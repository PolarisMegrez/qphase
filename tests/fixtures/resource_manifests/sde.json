{
  "schema_version": "qphase.resource/1",
  "resource_id": "sde",
  "package_version": "2.0.0",
  "engine": {
    "entry_point": "engine.sde",
    "target": "qphase_sde.engine:Engine"
  },
  "profiles": ["base", "compute", "simulation"],
  "plugin_classes": [
    {
      "namespace": "model",
      "protocol": "qphase_sde.model:SDEModelProtocol",
      "description": "Ito SDE model protocol, noise specification and initial state."
    },
    {
      "namespace": "integrator",
      "protocol": "qphase_sde.integrator.base:IntegratorProtocol",
      "description": "Fixed-step and adaptive SDE integrators."
    },
    {
      "namespace": "observer",
      "protocol": "qphase_sde.observer.base:ObserverProtocol",
      "description": "Online trajectory observers (first passage, bounds, masks)."
    },
    {
      "namespace": "analyser",
      "protocol": "qphase_sde.analyser.base:AnalyserProtocol",
      "description": "Engine-facing analysis adapters owning data kinds, reducers, workspace and progress."
    },
    {
      "namespace": "spectral_estimator",
      "protocol": "qphase_sde.spectral_estimator.base:SpectralEstimatorProtocol",
      "description": "Replaceable spectral estimators (periodogram, Welch, multitaper)."
    },
    {
      "namespace": "peak_finder",
      "protocol": "qphase_sde.peak_finder.base:PeakFinderProtocol",
      "description": "Peak-candidate finders returning unified PeakCandidate results."
    },
    {
      "namespace": "peak_tracker",
      "protocol": "qphase_sde.peak_tracker.base:PeakTrackerProtocol",
      "description": "Scan-axis peak-path trackers (e.g. topk_huber)."
    },
    {
      "namespace": "coherence_frequency",
      "protocol": "qphase_sde.coherence_frequency.base:CoherenceFrequencyProtocol",
      "description": "Coherence-frequency estimators (short-delay, band-limited, finite-delay, pole model)."
    }
  ],
  "data_products": [
    {
      "name": "trajectories",
      "kind": "time_series",
      "schema_ref": "qphase_sde.contracts.bundle:TRAJECTORY_PRODUCT",
      "description": "Simulated stochastic trajectories with sampling axis and realization semantics."
    },
    {
      "name": "spectrum",
      "kind": "spectral",
      "schema_ref": "qphase_sde.contracts.quantities:SPECTRUM_PRODUCT",
      "description": "Spectral estimates (amplitude, PSD, cross spectrum, coherence)."
    },
    {
      "name": "spectral_peaks",
      "kind": "statistics",
      "schema_ref": "qphase_sde.contracts.peaks:PEAK_PRODUCT",
      "description": "Unified peak candidates and scan-resolved peak paths."
    },
    {
      "name": "coherence_frequency",
      "kind": "statistics",
      "schema_ref": "qphase_sde.contracts.coherence:COHERENCE_FREQUENCY_PRODUCT",
      "description": "Coherence-frequency estimates with lag/bandwidth diagnostics."
    },
    {
      "name": "allan_variance",
      "kind": "statistics",
      "schema_ref": "qphase_sde.contracts.quantities:ALLAN_PRODUCT",
      "description": "Allan variance and scaling exponents."
    },
    {
      "name": "moments",
      "kind": "statistics",
      "schema_ref": "qphase_sde.contracts.quantities:MOMENT_FAMILY_PRODUCT",
      "description": "Moment families with shared independent counts and joint covariance."
    }
  ],
  "materializers": [
    {
      "name": "npz",
      "target": "qphase_sde.serialization.npz:NpzMaterializer",
      "formats": ["npz"]
    }
  ],
  "backend_capabilities": {
    "backends": ["numpy", "cupy"],
    "devices": ["cpu", "cuda"],
    "streaming": true
  },
  "optional_dependencies": [
    {
      "name": "cupy-cuda12x",
      "extra": "cupy",
      "purpose": "CUDA-resident integration, FFT and device-side reductions.",
      "required_for": ["backend"]
    }
  ],
  "compatibility": {
    "qphase_core": ">=2.0a0,<3.0"
  },
  "extra_assets": [
    {
      "path": "math",
      "kind": "directory",
      "visibility": "public",
      "purpose": "Backend-neutral numerical operations (coordinates, transforms)."
    },
    {
      "path": "serialization",
      "kind": "directory",
      "visibility": "private",
      "purpose": "Artifact adapters (NPZ now, optional Zarr later)."
    }
  ]
}
